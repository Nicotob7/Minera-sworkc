# Gmail SMTP para app/api/contact/route.ts
# Si usas un solo correo de contacto, repitelo asi:
# - SMTP_USER: correo Gmail que envia y autentica.
# - SMTP_FROM: mismo correo, solo con nombre visible.
# - CONTACT_TO: mismo correo, o el correo donde quieres recibir los mensajes.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu_contrasena_de_aplicacion_sin_espacios
SMTP_FROM="Formulario web SWC <tu-correo@gmail.com>"
CONTACT_TO=contacto@sworkc.cl
